# FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE (frontend/.env.example)
# Copy file này thành .env hoặc .env.production và thiết lập giá trị thích hợp:
#   cp .env.example .env

# URL của Backend API (trong production đi qua Nginx reverse proxy cùng domain hoặc domain API riêng)
VITE_API_BASE_URL=/api/v1

# Tên ứng dụng hiển thị trên thanh tiêu đề và Header
VITE_APP_TITLE="Hệ Thống Đặt Lịch Khám Bệnh - Phòng Khám Đa Khoa Quốc Tế"
