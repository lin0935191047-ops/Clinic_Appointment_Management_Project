# ==============================================================================
# CLINIC APPOINTMENT MANAGEMENT - ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Hướng dẫn: Copy file này thành .env và điền các giá trị phù hợp với môi trường của bạn:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ClinicAppointmentDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
DB_CONNECTION_STRING="Host=localhost;Port=5432;Database=ClinicAppointmentDb;Username=postgres;Password=your_postgres_password_here;"

# ------------------------------------------------------------------------------
# 2. BACKEND API CONFIGURATION (ASP.NET Core 8)
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=5000
BACKEND_HTTPS_PORT=5001
BACKEND_URL=http://localhost:5000
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 3. JWT & AUTHENTICATION SETTINGS
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=change_this_to_a_secure_random_string_with_at_least_32_characters!
JWT_ISSUER=ClinicAppointmentApi
JWT_AUDIENCE=ClinicAppointmentClient
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# Key mã hóa PII nhạy cảm (CCCD, Hộ chiếu, BHYT) và Keyed HMAC
PII_ENCRYPTION_KEY=change_this_to_a_32_bytes_secure_key_for_aes_gcm!
HMAC_SECRET_KEY=change_this_to_a_32_bytes_secure_key_for_keyed_hmac!

# ------------------------------------------------------------------------------
# 4. OTP CONFIGURATION (LOOKUP, RESCHEDULE, CANCEL)
# ------------------------------------------------------------------------------
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION (React / Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_TITLE="Hệ thống Quản lý và Đặt lịch Khám bệnh"
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# 6. EMAIL / NOTIFICATIONS
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@clinicmanagement.com
SMTP_FROM_NAME="Phòng khám Đa khoa Quốc tế"
SMTP_ENABLE_SSL=false

# ------------------------------------------------------------------------------
# 7. BUSINESS DEFAULTS (Theo SRS v1.2 Baseline)
# ------------------------------------------------------------------------------
DEFAULT_SLOT_DURATION_MINUTES=30
MAX_ADVANCE_BOOKING_DAYS=30
CANCELLATION_FULL_REFUND_MINUTES_THRESHOLD=60
