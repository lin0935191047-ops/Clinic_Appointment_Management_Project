# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*~

# ------------------------------------------
# Backend (.NET / C#)
# ------------------------------------------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
appsettings.Development.json
appsettings.Local.json
*.local.json
secrets.json

# Visual Studio / MSBuild
.vs/
Generated\ Files/
_ReSharper*/
*.DotSettings.user
*.ncrunch*
*.crunch*
*.rider*

# Test Results & Coverage
TestResults/
[Tt]est[Rr]esult*/
coverage/
*.cobertura.xml
*.opencover.xml

# Entity Framework Core bundle / migrations backup
*.efbundle.exe

# ------------------------------------------
# Frontend (Node / React / Vite / Next.js)
# ------------------------------------------
node_modules/
dist/
build/
.next/
out/
.turbo/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Storybook & UI tools
storybook-static/
.docusaurus/

# ------------------------------------------
# Database & Docker / Local Dev
# ------------------------------------------
postgres-data/
*.db
*.db-shm
*.db-wal
*.sql.bak
dump.rdb
.docker/

# ------------------------------------------
# Temporary & Cache Files
# ------------------------------------------
*.tmp
*.temp
.temp/
tmp/

